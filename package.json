{
  "name": "nextjs-expressjs-turborepo-boilerplate",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "IslandHop - Caribbean & Inter-Island Ferry Booking & Management Platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@repo/web",
    "build": "turbo build",
    "build:web": "turbo build --filter=@repo/web",
    "lint": "turbo lint",
    "lint:web": "turbo lint --filter=@repo/web",
    "typecheck": "turbo typecheck",
    "typecheck:web": "turbo typecheck --filter=@repo/web",
    "clean": "turbo clean",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.4.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
